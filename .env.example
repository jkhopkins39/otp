# ─────────────────────────────────────────────────────────────────
# One Talent Productions — environment variables
# Copy this file to ".env.local" for local dev.
# Set all of these in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (shared Hoppy Tech project) ──────────────────────────
# Prefer NEXT_PUBLIC_* so middleware can read them; non-prefixed aliases also work.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Aliases also accepted: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, HT_SUPABASE_*
# Project Settings → API → Secret key  (server-only — never expose to browser)
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# ── Admin auth (Hoppy Tech portal SSO) ────────────────────────────
# Sign-in is https://hoppytech.com/portal only.
# User needs app_metadata.tenant = "otp" (or role = "agency_owner").
# Visiting /admin redirects to the portal; callback is /admin/auth/callback.

# ── Resend (contact form email) ───────────────────────────────────
# 1. Add your domain at resend.com/domains and verify DNS
# 2. Create an API key at resend.com/api-keys
# 3. Set the three vars below
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# The "from" address — must be on your verified Resend domain
RESEND_FROM_EMAIL="contact@onetalentproductions.com"
# Where contact form submissions are delivered
RESEND_TO_EMAIL="onetalentproductions@gmail.com"

# ── Contact screening (optional) ──────────────────────────────────
# Set to "off" to skip Gemini screening (deterministic prefilter still runs)
# CONTACT_SCREENING=off
# Gemini key — screening fails open if unset (prefilter still runs)
# HT_GEMINI_API_KEY=
# GEMINI_API_KEY=
